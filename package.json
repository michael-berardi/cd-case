{
  "name": "@overseer/cd-case",
  "version": "0.1.0",
  "description": "A physically-grounded, interactive CD jewel case in three.js: refraction through the plastic shell, diffraction rainbow on the disc, and a hinge that swings the lid open.",
  "license": "MIT",
  "author": "Liberty Design Studio",
  "homepage": "https://cd-case.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michael-berardi/cd-case.git"
  },
  "bugs": {
    "url": "https://github.com/michael-berardi/cd-case/issues"
  },
  "keywords": [
    "three.js",
    "threejs",
    "webgl",
    "glsl",
    "cd",
    "jewel-case",
    "glass",
    "refraction",
    "iridescence",
    "diffraction",
    "web-component",
    "react",
    "design-module",
    "overseer"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/element.js",
    "./src/element.ts"
  ],
  "module": "./dist/cd-case.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/cd-case.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --config vite.demo.config.ts --host 127.0.0.1",
    "build": "npm run check && npm run build:lib && npm run build:demo",
    "ci": "npm run check && npm test && npm run check:showcase && npm run build:lib && npm run build:demo && npm run build:showcase",
    "build:lib": "vite build && tsc -p tsconfig.build.json",
    "build:demo": "vite build --config vite.demo.config.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview --config vite.demo.config.ts --host 127.0.0.1",
    "dev:showcase": "npm --prefix showcase run dev",
    "check:showcase": "npm --prefix showcase run check",
    "build:showcase": "npm --prefix showcase run build",
    "deploy": "npm --prefix showcase run deploy"
  },
  "peerDependencies": {
    "three": ">=0.170.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/three": "^0.186.0",
    "jsdom": "^26.0.0",
    "react": "^19.1.0",
    "three": "^0.186.1",
    "typescript": "^5.7.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
