---
const example = `import { createCdCase } from "@overseer/cd-case";

const cd = createCdCase("#stage", {
  title: "Refraction",
  accent: "#7fb2ff",
  quality: "medium",
});

await cd.open();
// When the view unmounts:
cd.dispose();`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="An interactive three.js CD jewel case. Open the lid, change the light, and use the module in your own project." />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0b0d12" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>CD case — OverSeer Design</title>
  </head>
  <body>
    <a class="skip" href="#controls">Skip to controls</a>
    <header>
      <a href="https://libertydesign.studio">Liberty Design Studio</a>
      <nav aria-label="Main"><a href="#use">Use the module</a><a href="https://www.bubbbly.com/cd-case">Reference ↗</a></nav>
    </header>
    <main>
      <h1>CD case.</h1>
      <section class="viewer" aria-label="Interactive jewel case">
        <div id="stage" role="img" aria-label="Three-dimensional clear jewel case with a hinged lid and a printed compact disc"></div>
        <p id="status" role="status">Loading case…</p>
        <noscript><p>JavaScript and WebGL 2 are required to display the case.</p></noscript>
        <form id="controls" aria-label="Case controls" tabindex="-1">
          <fieldset disabled id="control-fields">
            <legend class="sr-only">Case controls</legend>
            <div class="lid-controls" role="group" aria-label="Lid position">
              <button type="button" data-open="0">Closed</button>
              <button type="button" data-open="0.5">Half open</button>
              <button type="button" data-open="1">Open</button>
            </div>
            <label>Accent<input id="accent" type="color" value="#7fb2ff" /></label>
            <label>Quality<select id="quality"><option value="low">Low</option><option value="medium" selected>Medium</option><option value="high">High</option></select></label>
            <button id="motion" type="button" aria-pressed="false">Pause motion</button>
            <button id="reset" type="button">Reset view</button>
          </fieldset>
        </form>
      </section>
      <section id="use" class="usage">
        <div><h2>Use the module.</h2><p>JavaScript, React, or <code>&lt;cd-case&gt;</code>.</p><a href="/README.md">API &amp; examples ↗</a></div>
        <pre><code>{example}</code></pre>
      </section>
    </main>
    <footer><span>OverSeer Design</span><a href="/LICENSE.txt">MIT licence</a></footer>
    <script>
      import '../scripts/viewer.ts';
    </script>
  </body>
</html>
<style is:global>
  :root { color-scheme: dark; --canvas: #0b0d12; --ink: #eeece5; --muted: #b7bcc7; --line: #323844; --focus: #7fb2ff; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color: var(--ink); background: var(--canvas); }
  * { box-sizing: border-box; }
  body { margin: 0; }
  a { color: inherit; text-underline-offset: 5px; }
  a:hover { color: var(--focus); }
  a, button, input, select { -webkit-tap-highlight-color: transparent; }
  :focus-visible { outline: 2px solid var(--focus); outline-offset: 5px; }
  header, main, footer { width: min(1440px, calc(100% - 96px)); margin-inline: auto; }
  header { display: flex; justify-content: space-between; align-items: center; padding-block: 24px; border-bottom: 1px solid var(--line); gap: 24px; }
  header a { text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; }
  nav { display: flex; gap: 32px; }
  h1 { font-size: clamp(48px, 7.5vw, 112px); font-weight: 500; line-height: 1; letter-spacing: -.045em; margin: 48px 0 0; }
  #stage { width: 100%; height: clamp(360px, 53vw, 720px); background: var(--canvas); }
  #status { margin: 0 0 16px; color: var(--muted); }
  #status:empty { display: none; }
  #status[data-error] { color: #ffb4a9; }
  fieldset { padding: 24px 0; margin: 0; border: 0; border-block: 1px solid var(--line); display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; }
  label { display: flex; gap: 12px; align-items: center; }
  .lid-controls { display: flex; gap: 8px; margin-right: auto; }
  button, select { font: inherit; color: var(--ink); background: transparent; border: 1px solid #586171; border-radius: 4px; padding: 10px 16px; min-height: 44px; cursor: pointer; }
  button:hover, select:hover { background: #1b202a; }
  button:disabled, fieldset:disabled button, fieldset:disabled select, fieldset:disabled input { opacity: .5; cursor: wait; }
  input[type='color'] { width: 44px; height: 44px; background: transparent; border: 1px solid #586171; padding: 4px; border-radius: 4px; cursor: pointer; }
  .usage { display: grid; grid-template-columns: 1fr 1.4fr; gap: 64px; padding-block: 80px; }
  h2 { font-size: clamp(28px, 3vw, 40px); line-height: 1.1; font-weight: 500; letter-spacing: -.025em; margin: 0 0 24px; }
  p { line-height: 1.6; }
  .usage p { color: var(--muted); margin: 0 0 24px; }
  code, pre { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 14px; }
  pre { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.7; color: #c6d7ef; }
  footer { border-top: 1px solid var(--line); padding-block: 24px; display: flex; justify-content: space-between; align-items: center; gap: 24px; color: var(--muted); }
  footer a { display: inline-flex; align-items: center; min-height: 44px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  .skip { position: absolute; left: 24px; top: -100px; padding: 12px; background: var(--canvas); z-index: 1; }
  .skip:focus { top: 12px; }
  @media (max-width: 700px) {
    header, main, footer { width: calc(100% - 40px); }
    header { align-items: flex-start; font-size: 14px; padding-block: 16px; gap: 16px; }
    nav { gap: 4px; flex-direction: column; }
    h1 { margin-top: 32px; }
    #stage { height: 380px; }
    fieldset { gap: 16px; }
    .lid-controls { width: 100%; margin: 0; }
    .lid-controls button { flex: 1; padding-inline: 8px; }
    .usage { grid-template-columns: 1fr; padding-block: 48px; gap: 32px; }
    footer { font-size: 14px; }
  }
</style>
